enum Role {
    ADMIN,
    EMPLOYEE
}

type Employee {
    id: ID!
    userName: String!
    email: String!
    role: Role!
    department: Department!
}

type Department {
    id: ID!
    name: String!
}



# Queries

type EmployeePage {
    content: [Employee!]!
    currentPage: Int!
    totalPages: Int!
    totalItems: Int!
    hasNext: Boolean!
    hasPrevious: Boolean!
}

type Query {

    getEmployee(id: ID!): Employee
    getAllEmployees(page: Int = 1, size: Int = 3): EmployeePage!

    getDepartment(id: ID!): Department
    getAllDepartments: [Department]
}


# Mutations

type Mutation {

    createDepartment(input: CreateDepartmentInput!): Department!
    deleteDepartment(id: ID!): Boolean!

    createEmployee(departmentId: ID!, input: CreateEmployeeInput): String!
    deleteEmployee(id: ID!): Boolean!
}

# inputs

input CreateDepartmentInput {
    name: String!
}

input CreateEmployeeInput {
    username: String!
    email: String!
    password: String!
}
